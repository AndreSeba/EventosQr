# Copiá a .env y completá. NUNCA subas .env.
PORT=4000

# --- Supabase (Project Settings > API) ---
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Clave service_role (secreta, solo servidor)
SUPABASE_SERVICE_ROLE_KEY=

# --- Sesiones ---
# Cadena aleatoria larga:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# --- Primer administrador (solo se usa si la tabla usuarios está vacía) ---
ADMIN_EMAIL=admin@ejemplo.com
ADMIN_PASSWORD=

# --- Web (front) ---
# Orígenes permitidos por CORS, separados por coma
CORS_ORIGINS=http://localhost:5173
# URL pública del front: se usa para armar el link de venta de cada evento
FRONTEND_URL=http://localhost:5173

# --- Correo (Gmail con contraseña de aplicación) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=tucuenta@gmail.com
SMTP_PASS=
MAIL_FROM_NAME=EventosQr

# --- Límites ---
MAX_ENTRADAS_POR_ORDEN=5
MAX_COMPROBANTE_MB=2
# Poné true si corre detrás de un proxy (Render, Fly, etc.) para leer la IP real
TRUST_PROXY=true
