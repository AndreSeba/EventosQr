ADMIN_PASSWORD=

# --- Web (front) ---
# OrÃ­genes permitidos por CORS, separados por coma
CORS_ORIGINS=http://localhost:5173
# URL pÃºblica del front: se usa para armar el link de venta de cada evento
FRONTEND_URL=http://localhost:5173

# --- Correo (Gmail con contraseÃ±a de aplicaciÃ³n) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=tucuenta@gmail.com
