# CopiÃ¡ a .env y completÃ¡. NUNCA subas .env.
PORT=4000

# --- Supabase (Project Settings > API) ---
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Clave service_role (secreta, solo servidor)
SUPABASE_SERVICE_ROLE_KEY=

# --- Sesiones ---
# Cadena aleatoria larga:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# --- Primer administrador (solo se usa si la tabla usuarios estÃ¡ vacÃ­a) ---
